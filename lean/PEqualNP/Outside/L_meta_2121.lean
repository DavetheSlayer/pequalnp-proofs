-- The edge function of the 4-cycle with parts 0, 1 and 2, 3.
def f : (Fin 4 → Bool) → Bool := fun z : Fin 4 → Bool => (z 0 && z 2) || (z 0 && z 3) || (z 1 && z 2) || (z 1 && z 3)

-- The formula of the link module at 4 inputs, 2 gates, all 16 rows.
def F : List (List ℕ) := enc 4 2 (rowFun 4 f) (List.range 16)

-- Formula clause i is stored under key i.
def fk : List ℕ := List.range' 1 729

