theorem unsat : ¬ FormulaSat F := check_sound F fk toks (by decide +kernel)

theorem main : ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C → PEqualNP.MetaComplexity.NestedCover.ReadsBack 4 C → (∀ x : Fin 4 → Bool, C.eval (List.ofFn x) = (fun z : Fin 4 → Bool => (z 0 && z 2) || (z 0 && z 3) || (z 1 && z 2) || (z 1 && z 3)) x) → 3 ≤ C.size := by
  intro C hM _ hev
  have hrows : ∀ r ∈ List.range 16, r < 2 ^ 4 := by
    intro r hr
    simpa using List.mem_range.1 hr
  exact lower_of_unsat 4 2 f (List.range 16) hrows unsat C hM hev

end PnpLmeta2121

theorem PEqualNP.Outside.L_meta_2121 : ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C → PEqualNP.MetaComplexity.NestedCover.ReadsBack 4 C → (∀ x : Fin 4 → Bool, C.eval (List.ofFn x) = (fun z : Fin 4 → Bool => (z 0 && z 2) || (z 0 && z 3) || (z 1 && z 2) || (z 1 && z 3)) x) → 3 ≤ C.size := PnpLmeta2121.main
