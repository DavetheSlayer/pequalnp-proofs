theorem main : ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C → PEqualNP.MetaComplexity.NestedCover.ReadsBack 5 C → (∀ x : Fin 5 → Bool, C.eval (List.ofFn x) = (fun z : Fin 5 → Bool => (z 0 && z 2) || (z 0 && z 3) || (z 0 && z 4) || (z 1 && z 2) || (z 1 && z 3) || (z 1 && z 4)) x) → 4 ≤ C.size := by
  intro C hM _ hev
  have hrows : ∀ r ∈ List.range 32, r < 2 ^ 5 := by
    intro r hr
    simpa using List.mem_range.1 hr
  exact lower_of_unsat 5 3 f (List.range 32) hrows unsat C hM hev

end PnpLmeta2135

theorem PEqualNP.Outside.L_meta_2135 : ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C → PEqualNP.MetaComplexity.NestedCover.ReadsBack 5 C → (∀ x : Fin 5 → Bool, C.eval (List.ofFn x) = (fun z : Fin 5 → Bool => (z 0 && z 2) || (z 0 && z 3) || (z 0 && z 4) || (z 1 && z 2) || (z 1 && z 3) || (z 1 && z 4)) x) → 4 ≤ C.size := PnpLmeta2135.main
